# Copy to .env and fill in. .env is git-ignored.
#
# Planyo's own documentation is explicit that the API key must
# never appear in client-side JavaScript, so it is read here by
# server/dev-server.mjs and never sent to the browser. The
# booking portal only ever talks to /api/planyo on this server.

# Required to switch the booking portal from sample data to live
# availability. Get it from Planyo: Site settings → Integration → API.
PLANYO_API_KEY=

# Only if the API key is configured to use a hash key.
PLANYO_HASH_KEY=

# Your Planyo site ID. Required for metasite API keys.
PLANYO_SITE_ID=

# The resource ID for the boat (Razis). Leave empty to query all
# resources on the site.
PLANYO_RESOURCE_ID=

# Local port for the dev server.
PORT=4321
