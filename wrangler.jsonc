{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "source-to-sea-v2",
  "compatibility_date": "2026-08-17",
  "main": "./worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
